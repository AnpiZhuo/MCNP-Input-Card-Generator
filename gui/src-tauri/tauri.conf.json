{
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "MCNP \u8f93\u5165\u5361\u751f\u6210\u5668",
    "version": "1.6.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "open": true,
        "sidecar": true,
        "scope": [
          {
            "name": "python",
            "cmd": "python",
            "sidecar": true,
            "args": true
          }
        ]
      },
      "dialog": {
        "open": true,
        "save": true
      },
      "fs": {
        "readFile": true,
        "writeFile": true,
        "scope": [
          "**"
        ]
      }
    },
    "bundle": {
      "active": false,
      "targets": "all",
      "externalBin": ["python"],
      "identifier": "com.mcnp.generator",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "MCNP \u8f93\u5165\u5361\u751f\u6210\u5668",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "center": true
      }
    ]
  }
}